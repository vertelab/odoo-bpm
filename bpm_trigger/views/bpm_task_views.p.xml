<odoo>
  <data>

    <record id="bpm_task_trigger_form" model="ir.ui.view">
      <field name="name">bpm.task.trigger.form</field>
      <field name="model">bpm.task</field>
      <field name="inherit_id" ref="bpm_workflow.view_bpm_task_form"/>
      <field name="arch" type="xml">
        <field name="parent_id" position="after">
          <field name="trigger_type" invisible="task_type != 'decision'"/>
          <field name="model_name" invisible="not model_id"/>
          <field name="model_id" invisible="task_type != 'decision'"/>
          <field name="filter_domain" widget="domain" options="{'model': 'model_name'}" invisible="not model_id or trigger_type != 'chatter'"/>
          <field name="code" invisible="not model_id or trigger_type != 'code'"/>
        </field>
      </field>
    </record>

  </data>
</odoo>