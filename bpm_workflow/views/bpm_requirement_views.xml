<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Search View -->
        <record id="view_bpm_requirement_search" model="ir.ui.view">
            <field name="name">bpm.requirement.search</field>
            <field name="model">bpm.requirement</field>
            <field name="arch" type="xml">
                <search string="BPM Requirements">
                    <field name="name"/>
                    <field name="priority"/>
                    <field name="req_type"/>
                    <field name="bpm_id"/>
                    <!--
                            <filter string="Must" domain="[('priority','=','must')]"/>
                            <filter string="Should" domain="[('priority','=','should')]"/>
                            <filter string="Could" domain="[('priority','=','could')]"/>
                    -->
                    <group expand="1" string="Group By">
                        <filter string="Priority" name="group_by_priority" context="{'group_by':'priority'}"/>
                        <filter string="Type" name="group_by_type" context="{'group_by':'req_type'}"/>
                        <filter string="BPM Workflow" name="group_by_bpm" context="{'group_by':'bpm_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- List View -->
        <record id="view_bpm_requirement_tree" model="ir.ui.view">
            <field name="name">bpm.requirement.tree</field>
            <field name="model">bpm.requirement</field>
            <field name="arch" type="xml">
                <list string="BPM Requirements">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="priority" optional="show"/>
                    <field name="req_type" optional="hide"/>
                    <field name="bpm_id" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_bpm_requirement_form" model="ir.ui.view">
            <field name="name">bpm.requirement.form</field>
            <field name="model">bpm.requirement</field>
            <field name="arch" type="xml">
                <form string="BPM Requirement">
                    <header>
                        <field name="state" widget="statusbar_duration" options="{'clickable': '1', 'fold_field': 'fold'}" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box" groups="base.group_user" />
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                        <div class="oe_title flex-grow-1 w-80">
                            <label for="name" string="Name"/>
                            <h1 class="d-flex flex-row">
                                <field name="name" options="{'line_breaks': False}" widget="text" class="w-80 flex-grow-1 o_text_overflow" placeholder="e.g. Requirement" />
                                <field name="priority" class="ms-3 text-end" style="width: 7em; font-size: 0.7em; line-height: 2;" />
                            </h1>
                        </div>
                        <group>
                            <field name="priority"/>
                            <field name="req_type"/>
                            <field name="sequence"/>
                            <field name="bpm_id"/>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" nolabel="1"/>
                            </page>
                            <page string="Tasks">
                                <field name="task_ids" context="{'default_req_id': id,'default_bpm_id': bpm_id}">
                                    <list string="Task" editable="bottom">
                                        <field name="sequence" widget="handle" />
                                        <field name="task_id" context="{'default_bpm_id': bpm_id}" />
                                        <field name="task_type" />
                                        <field name="task_state" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
