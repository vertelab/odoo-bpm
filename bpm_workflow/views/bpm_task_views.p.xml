<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpm_task_search" model="ir.ui.view">
        <field name="name">bpm.task.search</field>
        <field name="model">bpm.task</field>
        <field name="arch" type="xml">
            <search string="BPM Tasks">
                <field name="name" />
                <field name="state" />
                <field name="user_id" />
                <field name="parent_id" />
                <group expand="1" string="Group By">
                    <filter string="Type" name="group_by_task_type" context="{'group_by':'task_type'}" />
                    <filter string="State" name="group_by_state" context="{'group_by':'state'}" />
                    <filter string="Parent Task" name="group_by_parent" context="{'group_by':'parent_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_bpm_task_tree" model="ir.ui.view">
        <field name="name">bpm.task.tree</field>
        <field name="model">bpm.task</field>
        <field name="arch" type="xml">
            <list string="BPM Tasks">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="state" optional="show" />
                <field name="task_type" optional="hide" />
                <field name="decision_type" optional="hide" />
                <field name="user_id" optional="hide" />
                <field name="parent_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_bpm_task_form" model="ir.ui.view">
        <field name="name">bpm.task.form</field>
        <field name="model">bpm.task</field>
        <field name="arch" type="xml">
            <form string="BPM Task">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="base.group_user" />
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <field name="image_128" nolabel="1" widget="image" class="oe_avatar me-3" style="width: 128px; height: 128px; flex: 0 0 auto;"/>
                    <div class="oe_title flex-grow-1 w-80">
                        <label for="name" string="Name"/>
                        <h1 class="d-flex flex-row">
                            <field name="name" options="{'line_breaks': False}" widget="text" class="w-80 flex-grow-1 o_text_overflow" placeholder="e.g. Task" />
                        </h1>
                    </div>
                    <group>
                        <field name="task_type" />
                    </group>
                    <notebook>
                        <page string="Parents" invisible="task_type == 'start'">
                            <field name="parent_ids" context="{'default_bpm_id': bpm_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>    
                                    <field name="parent_id"/>
                                    <field name="bpm_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Children" invisible="task_type == 'end'">
                            <field name="child_ids" context="{'default_bpm_id': bpm_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="child_id"/>
                                    <field name="option"/>
                                    <field name="bpm_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" id="desc">
                            <field name="description" />
                        </page>
                        <page string="Process Data" id="process">
                            <field name="process_data" />
                        </page>
                        <page string="Requirements" id="requirements">
                            <field name="requirement_ids" context="{'default_task_id': id,'default_bpm_id': bpm_id}">
                                <list string="Requirements" editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="req_id" context="{'default_bpm_id': bpm_id}" />
                                    <field name="req_type" />
                                    <field name="req_state" />
                                </list>
                            </field>
                        </page>
                        <page string="Diagram Editor" id="mermaid_editor">
                            <field name="mermaid_editor" no-label="1" />
                        </page>
                        <page string="Diagram" id="mermaid_diagram">
                            <field name="mermaid_diagram" widget="mermaid" no-label="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bpm_task_kanban" model="ir.ui.view">
        <field name="name">bpm.task.kanban</field>
        <field name="model">bpm.task</field>
        <field name="arch" type="xml">
            <kanban string="BPM Task">
                <field name="name"/>
                <field name="state"/>
                <field name="task_type"/>
                <field name="decision_type"/>
                <field name="user_id"/>
                <field name="parent_id"/>
                <templates>
                    <t t-name="menu">
                        <a type="open" class="dropdown-item">More Info</a>
                        <t t-if="widget.deletable">
                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        </t>
                    </t>
                    <t t-name="card" class="flex-row align-items-center">
                        <aside>
                            <field name="image_128" alt="Contact image" widget="image" options="{'img_class': 'object-fit-cover'}" />
                        </aside>

                        <main class="me-4">
                            <widget name="web_ribbon" title="Done" bg_color="bg-success" icon="fa-times" invisible="state != 'done'"/>

                            <widget name="web_ribbon" title="Ongoing" bg_color="bg-warning" icon="fa-file-text" invisible="state != 'ongoing'"/>

                            <widget name="web_ribbon" title="Draft" bg_color="bg-danger" icon="fa-times" invisible="state != 'draft'"/>

                            <field class="fw-bold fs-5" name="name" />
                            <p class="text-muted small my-0 lh-sm">
                                <div>
                                    <field name="requirement_names_ids" widget="many2many_tags" />
                                </div>
                            </p>
                            <footer class="w-100 justify-content-between">
                                <field name="user_id" widget="many2one_avatar_user" />
                                <field name="task_type" />
                                <field name="activity_ids" class="float-end" widget="kanban_activity"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bpm_task" model="ir.actions.act_window">
        <field name="name">BPM Task</field>
        <field name="res_model">bpm.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_bpm_task_kanban" />
    </record>

    <record model="ir.actions.act_window" id="open_bpm_tasks_thread_kanban">
        <field name="name">BPM Tasks</field>
        <field name="res_model">bpm.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="view_id" ref="view_bpm_task_kanban" />
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_bpm_task" name="BPM Tasks" parent="bpm_workflow.menu_bpm_workflow" action="action_bpm_task" sequence="20" />

</odoo>
