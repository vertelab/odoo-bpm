                                    <small>
                                        Date:
                                        <field name="date" />
                                    </small>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record> -->

        <!-- Calendar View -->
        <record id="view_bpm_workflow_calendar" model="ir.ui.view">
            <field name="name">bpm.workflow.calendar</field>
            <field name="model">bpm.workflow</field>
            <field name="arch" type="xml">
                <calendar string="Business Process Management Calendar" date_start="date">
                    <field name="name" />
                    <field name="state" />
                </calendar>
            </field>
        </record>

        <record id="action_bpm_workflow" model="ir.actions.act_window">
            <field name="name">BPM Workflows</field>
            <field name="res_model">bpm.workflow</field>
            <field name="view_mode">kanban,list,form,calendar</field>
            <field name="view_id" ref="view_bpm_workflow_kanban" />
        </record>

        <menuitem id="menu_bpm_workflow_root" name="Business Process Management" sequence="10" />
        <menuitem id="menu_bpm_workflow" name="BPM" parent="menu_bpm_workflow_root" action="action_bpm_workflow" sequence="20" />
    </data>
</odoo>