<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Actions referenced by the form view below. Defined here (before
             the form) to avoid forward references to later-loaded files. -->
        <record id="action_bpm_instance" model="ir.actions.act_window">
            <field name="name">Process Instances</field>
            <field name="res_model">bpm.instance</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <record id="action_bpmn_import_wizard" model="ir.actions.act_window">
            <field name="name">Import BPMN 2.0 XML</field>
            <field name="res_model">bpm.bpmn.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_workflow_id': active_id}</field>
        </record>

        <!-- Search View -->
        <record id="view_bpm_workflow_search" model="ir.ui.view">
            <field name="name">bpm.workflow.search</field>
            <field name="model">bpm.workflow</field>
            <field name="arch" type="xml">
                <search string="Business Process Management">
                    <field name="name" />
                    <field name="version" />
                    <field name="state" />
                    <filter name="draft" string="Draft" domain="[('state','=','draft')]" />
                    <filter name="approved" string="Approved" domain="[('state','=','approved')]" />
                    <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]" />
                    <filter name="deprecated" string="Deprecated" domain="[('state','=','deprecated')]" />
                    <filter name="by_author" string="My Workflows (author)" domain="[('author_id','=',uid)]" groups="base.group_user" />
                    <filter name="by_owner" string="My Workflows (owner)" domain="[('process_owner_id','=',uid)]" groups="base.group_user" />
                    <!-- Additional group by filters -->
                    <group expand="1" string="Group By">
                        <filter string="Author" name="group_by_author" context="{'group_by':'author_id'}" />
                        <filter string="Process Owner" name="group_by_process_owner" context="{'group_by':'process_owner_id'}" />
                        <filter string="Parent Process" name="group_by_parent" context="{'group_by':'parent_id'}" />
                        <filter string="State" name="group_by_state" context="{'group_by':'state'}" />
                        <filter string="Approved By" name="group_by_approved_by" context="{'group_by':'approved_by_id'}" />
                    </group>
                </search>
            </field>
        </record>
        <!-- Form View -->
        <record id="view_bpm_workflow_form" model="ir.ui.view">
            <field name="name">bpm.workflow.form</field>
            <field name="model">bpm.workflow</field>
            <field name="arch" type="xml">
                <form string="Business Process Management">
                    <header>
                        <button name="button_major_version" string="Major Version" type="object" class="oe_highlight" groups="bpm_workflow.group_bpm_manager" data-hotkey="m" />
                        <button name="button_minor_version" string="Minor Version" type="object" class="oe_highlight" groups="bpm_workflow.group_bpm_manager" data-hotkey="n" />
                        <button name="action_generate_diagram" class="btn btn-primary" type="object" string="Create Diagram" />
                        <button name="%(action_bpmn_import_wizard)d" type="action" string="Import BPMN" class="btn-secondary" groups="bpm_workflow.group_bpm_manager" />
                        <button name="action_export_bpmn" class="btn btn-secondary" type="object" string="Export BPMN" groups="bpm_workflow.group_bpm_user" />
                        <button name="%(action_bpm_instance)d" type="action" string="Start Instance" class="btn-primary"
                                context="{'default_workflow_id': active_id, 'default_state': 'running'}"
                                invisible="state != 'approved'"/>
                        <!--
                             <field name="state" widget="statusbar_duration" options="{'clickable': '1', 'fold_field': 'fold'}" groups="project.group_project_stages" domain="[('company_id', 'in', (company_id, False))]" />
                        -->
                        <field name="state" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}" />
                    </header>
                    <sheet string="BPM">
                        <div class="oe_button_box" name="button_box" groups="base.group_user">
                            <button class="oe_stat_button" type="object" name="action_requirements" icon="fa-check">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Requirements</span>
                                    <span class="o_stat_value">
                                        <field name="closed_requirements_count" />
                                        /
                                        <field name="requirements_count" />
                                        (
                                        <field name="requirements_percentage" widget="percentage" options="{'digits': [1, 0]}" />
                                        )
                                    </span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object" name="action_tasks" icon="fa-cogs">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Tasks</span>
                                    <span class="o_stat_value">
                                        <field name="closed_tasks_count" />
                                        /
                                        <field name="tasks_count" />
                                        (
                                        <field name="tasks_percentage" widget="percentage" options="{'digits': [1, 0]}" />
                                        )
                                    </span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object" name="action_view_mgmt_actions" icon="fa-lightbulb-o"
                                    invisible="mgmt_action_count == 0">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Improvements</span>
                                    <span class="o_stat_value"><field name="mgmt_action_count"/></span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object" name="action_view_mgmt_nonconformities" icon="fa-exclamation-triangle"
                                    invisible="mgmt_nonconformity_count == 0">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Nonconf.</span>
                                    <span class="o_stat_value"><field name="mgmt_nonconformity_count"/></span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object" name="action_view_mgmt_links" icon="fa-link"
                                    invisible="mgmt_link_count == 0">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Standard Links</span>
                                    <span class="o_stat_value"><field name="mgmt_link_count"/></span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                            <div class="oe_title">
                                <h1 class="d-flex flex-row">
                                    <!--
                                         <field name="is_favorite" nolabel="1" widget="project_is_favorite" class="me-2" options="{'autosave': False}"/>
                                    -->
                                    <field name="name" options="{'line_breaks': False}" widget="text" class="o_text_overflow" placeholder="e.g. Office Party" />
                                </h1>
                            </div>
                        </group>
                        <group col="2">
                            <group id="c1">
                                <field name="parent_id" />
                                <field name="version" class="oe_inline"/>
                                <field name="date" class="oe_inline"/>
                                <field name="author_id" />
                                <field name="process_owner_id" />
                                <field name="approved_by_id" />
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" />
                            </group>
                            <group id="c2">

                            </group>
                        </group>
                        <notebook>
                            <page string="Description" id="desc">
                                <field name="description" no-label="1" />
                            </page>
                            <page string="Goals" id="goals">
                                <field name="goals" no-label="1" />
                            </page>
                            <page string="Success Critera/Risks" id="success_criteria">
                                <group>
                                    <field name="success_criteria" />
                                    <field name="risks" />
                                </group>
                            </page>
                            <page string="Diagram Editor" id="mermaid_editor">
                                <group>
                                    <field name="bpm_diagram_type"/>
<!--                                    <field name="prompt"/>-->
                                </group>
                                <field name="mermaid_editor" no-label="1" />
                            </page>
                            <page string="Diagram" id="mermaid_diagram">
                                <field name="mermaid_diagram" widget="mermaid" no-label="1" />
                            </page>
                            <page string="Management System" id="mgmt_system" groups="bpm_workflow.group_bpm_manager">
                                <group string="Standard Links (policies, clauses, processes, objectives)">
                                    <field name="mgmt_link_ids" mode="kanban">
                                        <kanban>
                                            <field name="res_model"/>
                                            <field name="res_name"/>
                                            <field name="standard"/>
                                            <field name="link_type"/>
                                            <templates>
                                                <t t-name="card">
                                                    <div class="oe_kanban_card">
                                                        <div>
                                                            <field name="standard" widget="badge"/>
                                                            <strong><field name="res_name"/></strong>
                                                        </div>
                                                        <div class="text-muted small">
                                                            <field name="link_type"/> • <field name="res_model"/>
                                                        </div>
                                                    </div>
                                                </t>
                                            </templates>
                                        </kanban>
                                    </field>
                                </group>
                                <group string="Shared Entities">
                                    <field name="mgmt_action_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="mgmt_nonconformity_ids" widget="many2many_tags" readonly="0"/>
                                    <field name="mgmt_audit_ids" widget="many2many_tags"/>
                                    <field name="mgmt_last_improvement_date"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <!-- List (Tree) View -->
        <record id="view_bpm_workflow_tree" model="ir.ui.view">
            <field name="name">bpm.workflow.tree</field>
            <field name="model">bpm.workflow</field>
            <field name="arch" type="xml">
                <list string="Business Process Managements">
                    <field name="name" />
                    <field name="version" />
                    <field name="state" />
                    <field name="date" />
                    <field name="author_id" />
                    <field name="process_owner_id" />
                </list>
            </field>
        </record>

        <record id="view_bpm_workflow_kanban" model="ir.ui.view">
            <field name="name">bpm.workflow.kanban</field>
            <field name="model">bpm.workflow</field>
            <field name="arch" type="xml">
                <kanban string="BPM Workflow">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="author_id"/>
                    <field name="parent_id"/>
                    <templates>
                        <t t-name="menu">
                            <a type="open" class="dropdown-item">More Info</a>
                        </t>
                        <t t-name="card" class="flex-row align-items-center">
                            <aside>
                                <field name="image_128" alt="Contact image" widget="image" options="{'img_class': 'object-fit-cover'}" />
                            </aside>

                            <main class="me-4">
                                <widget name="web_ribbon" title="Done" bg_color="bg-success" icon="fa-times" invisible="state != 'done'"/>

                                <widget name="web_ribbon" title="Ongoing" bg_color="bg-warning" icon="fa-file-text" invisible="state != 'ongoing'"/>

                                <widget name="web_ribbon" title="Draft" bg_color="bg-danger" icon="fa-times" invisible="state != 'draft'"/>

                                <field class="fw-bold fs-5" name="name" />
                                <!-- <p class="text-muted small my-0 lh-sm">
                                    <div>
                                        <field name="requirement_names_ids" widget="many2many_tags" />
                                    </div>
                                </p> -->
                                <footer class="w-100 justify-content-between">
                                    <field name="author_id" widget="many2one_avatar_user" />
                                    <field name="activity_ids" class="float-end" widget="kanban_activity"/>
                                </footer>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Kanban View -->
        <!-- <record id="view_bpm_workflow_kanban" model="ir.ui.view">
