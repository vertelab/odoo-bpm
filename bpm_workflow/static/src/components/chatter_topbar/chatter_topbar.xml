<templates xml:space="preserve">

    <t
        t-name="bpm_workflow.ChatterTopbar"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <xpath expr="//Dropdown" position="before">
            <button
                class="o_ChatterTopbar_button o_ChatterTopbar_buttonBpmWorkflow btn btn-light btn-primary"
                type="button"
                t-att-disabled="!state.thread.hasWriteAccess"
                t-on-click="onClickShowBpmWorkflow"
                t-if="props.webRecord.data.non_conformity_count !== undefined"
            >
                <i
                    class="fa fa-folder-open fa-lg me-1"
                    role="img"
                    aria-label="BPM Workflow"
                />
                <span
                    class="o_ChatterTopbar_buttonCount o_ChatterTopbar_buttonBPMWorkflowCount"
                    t-esc="props.webRecord.data.non_conformity_count"
                />
            </button>
        </xpath>
    </t>
</templates>
