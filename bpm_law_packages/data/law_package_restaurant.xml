        <!-- Package: Restaurant (Restaurang)                      -->
        <!-- ══════════════════════════════════════════════════════ -->
        <record id="law_package_restaurant" model="bpm.law.package">
            <field name="name">Restaurant — Restaurang</field>
            <field name="description">Laws for restaurants: food safety, alcohol, tobacco, work environment, premises, and consumer protection.</field>
