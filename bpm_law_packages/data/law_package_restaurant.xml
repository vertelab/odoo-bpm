            <field name="package_id" ref="law_package_restaurant"/>
            <field name="name">Livsmedelslag (2006:804)</field>
            <field name="sfs_number">2006:804</field>
            <field name="department">Landsbygds- och infrastrukturdepartementet</field>
            <field name="category">food</field>
            <field name="description">Grundläggande livsmedelslagstiftning. Krav på säker mat, spårbarhet, egenkontroll.</field>
            <field name="sequence">10</field>
        </record>

        <record id="rest_lmf" model="bpm.law.package.line">
            <field name="package_id" ref="law_package_restaurant"/>
