<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- Package: Retail (Butik)                               -->
        <!-- ══════════════════════════════════════════════════════ -->
        <record id="law_package_retail" model="bpm.law.package">
            <field name="name">Retail Store — Butik</field>
            <field name="description">Laws for retail stores: consumer sales, pricing, returns, premises, employment, and product safety.</field>
            <field name="business_type">retail</field>
            <field name="size_category">small</field>
        </record>

        <!-- Consumer Sales -->
        <record id="retail_kkl" model="bpm.law.package.line">
            <field name="package_id" ref="law_package_retail"/>
            <field name="name">Konsumentköplag (2022:260)</field>
            <field name="sfs_number">2022:260</field>
            <field name="department">Justitiedepartementet</field>
            <field name="category">marketing</field>
            <field name="description">Central lag för all butiksförsäljning. Reklamation, garanti, 3 års reklamationsrätt.</field>
            <field name="sequence">10</field>
        </record>

        <record id="retail_prisinform" model="bpm.law.package.line">
            <field name="package_id" ref="law_package_retail"/>
            <field name="name">Prisinformationslag (2004:347)</field>
            <field name="sfs_number">2004:347</field>
            <field name="department">Finansdepartementet</field>
            <field name="category">marketing</field>
            <field name="description">Krav på tydlig prismärkning, jämförpris, pris per enhet.</field>
            <field name="sequence">20</field>
        </record>

        <record id="retail_mfl" model="bpm.law.package.line">
            <field name="package_id" ref="law_package_retail"/>
