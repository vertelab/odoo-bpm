            <field name="sfs_number">2005:59</field>
            <field name="department">Justitiedepartementet</field>
            <field name="category">marketing</field>
            <field name="description">Ångerrätt 14 dagar vid distansförsäljning, informationskrav före köp.</field>
            <field name="sequence">30</field>
        </record>

