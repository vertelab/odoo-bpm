            <field name="sfs_number">EU 2022/2065</field>
            <field name="department">Finansdepartementet</field>
            <field name="category">marketing</field>
            <field name="description">Transparens, rapporteringskrav, klagomålshantering. Gäller alla onlineplattformar.</field>
            <field name="sequence">25</field>
        </record>

        <record id="web_dma" model="bpm.law.package.line">
            <field name="package_id" ref="law_package_webshop"/>
            <field name="name">EU:s Digital Markets Act (DMA) — Förordning (EU) 2022/1925</field>
            <field name="sfs_number">EU 2022/1925</field>
            <field name="category">marketing</field>
            <field name="description">Gäller större plattformar. Rättvis konkurrens på digitala marknader.</field>
            <field name="sequence">27</field>
        </record>

