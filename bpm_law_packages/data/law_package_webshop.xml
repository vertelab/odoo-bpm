            <field name="sfs_number">2018:218</field>
            <field name="category">data</field>
            <field name="description">Cookie-samtycke, nyhetsbrev, kundregister, personuppgiftsbiträdesavtal med betalleverantörer.</field>
            <field name="sequence">30</field>
            <field name="size_threshold">250_emp_40m</field>
        </record>

        <record id="web_lekk" model="bpm.law.package.line">
            <field name="package_id" ref="law_package_webshop"/>
