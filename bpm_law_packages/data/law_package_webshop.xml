<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- Package: Web Shop (E-handel)                          -->
        <!-- ══════════════════════════════════════════════════════ -->
        <record id="law_package_webshop" model="bpm.law.package">
            <field name="name">Web Shop — E-handel</field>
            <field name="description">Laws for web shops: distance selling, e-commerce, consumer rights, cookies, GDPR, marketing, payments, and logistics.</field>
            <field name="business_type">webshop</field>
            <field name="size_category">small</field>
        </record>

        <!-- Distance Selling -->
        <record id="web_distans" model="bpm.law.package.line">
            <field name="package_id" ref="law_package_webshop"/>
            <field name="name">Lag om distansavtal och avtal utanför affärslokaler (2005:59)</field>
            <field name="sfs_number">2005:59</field>
            <field name="department">Justitiedepartementet</field>
            <field name="category">marketing</field>
            <field name="description">14 dagars ångerrätt, informationskrav före köp, ångerrättsblankett.</field>
            <field name="sequence">10</field>
        </record>

        <record id="web_kkl" model="bpm.law.package.line">
            <field name="package_id" ref="law_package_webshop"/>
            <field name="name">Konsumentköplag (2022:260)</field>
            <field name="sfs_number">2022:260</field>
            <field name="category">marketing</field>
            <field name="sequence">15</field>
        </record>

        <!-- E-commerce specific -->
        <record id="web_ekomm" model="bpm.law.package.line">
            <field name="package_id" ref="law_package_webshop"/>
