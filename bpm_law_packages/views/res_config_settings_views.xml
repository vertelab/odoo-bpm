<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_res_config_settings_law_packages" model="ir.ui.view">
            <field name="name">res.config.settings.law.packages</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='business_documents']" position="after">
                    <h2>Law Packages</h2>
                    <div class="row mt16 o_settings_container" id="law_packages_settings">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <span class="fa fa-balance-scale fa-2x"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="text-muted mb-2">
                                    Select pre-configured law packages based on your
                                    business activities. Laws will be loaded into the
                                    law monitoring system for management system tracking.
                                </div>
                                <div class="mb-3">
                                    <label for="law_package_business_type" class="o_form_label">
                                        Quick-select by business type
                                    </label>
                                    <field name="law_package_business_type" class="oe_inline"/>
                                    <button name="action_select_business_type"
                                            string="Load Package"
                                            type="object"
                                            class="btn btn-secondary ms-2"
                                            icon="fa-download"/>
                                </div>
                                <div>
                                    <label for="law_package_ids" class="o_form_label">
                                        Active Law Packages
                                    </label>
                                    <field name="law_package_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </div>
                                <div class="text-muted mt-2 small">
                                    <i class="fa fa-info-circle"/> You can select multiple
                                    packages if your business spans several activities.
                                    Laws with size thresholds (e.g. "5+ employees")
                                    are included but highlighted — activate when your
                                    company grows past the threshold.
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
