<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Law Package Tree View                           -->
        <!-- ═══════════════════════════════════════════════ -->
        <record id="view_law_package_tree" model="ir.ui.view">
            <field name="name">bpm.law.package.tree</field>
            <field name="model">bpm.law.package</field>
            <field name="arch" type="xml">
                <tree string="Law Packages">
                    <field name="name"/>
                    <field name="business_type" optional="show"/>
                    <field name="size_category" optional="show"/>
                    <field name="law_count"/>
                </tree>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Law Package Form View                           -->
        <!-- ═══════════════════════════════════════════════ -->
        <record id="view_law_package_form" model="ir.ui.view">
            <field name="name">bpm.law.package.form</field>
            <field name="model">bpm.law.package</field>
            <field name="arch" type="xml">
                <form string="Law Package">
                    <header>
                        <button name="action_apply_to_company" string="Apply to Company"
                                type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <field name="business_type"/>
                            <field name="size_category"/>
                            <field name="description"/>
                        </group>
                        <notebook>
                            <page string="Laws" name="laws">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="category" optional="show"/>
                                        <field name="sfs_number"/>
                                        <field name="name"/>
                                        <field name="department" optional="hide"/>
                                        <field name="size_category" optional="show"/>
                                        <field name="min_employees" optional="hide"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Active For" name="companies">
                                <field name="company_ids" widget="many2many_tags"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Law Package Kanban View                         -->
        <!-- ═══════════════════════════════════════════════ -->
        <record id="view_law_package_kanban" model="ir.ui.view">
            <field name="name">bpm.law.package.kanban</field>
            <field name="model">bpm.law.package</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="business_type"/>
                    <field name="size_category"/>
                    <field name="law_count"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_content">
                                    <div><strong><field name="name"/></strong></div>
                                    <div class="text-muted small">
                                        <field name="business_type"/>
                                        <t t-if="record.size_category.raw_value">
                                            • <field name="size_category"/>
                                        </t>
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge bg-info">
                                            <field name="law_count"/> laws
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Lagen.nu Import Wizard View                    -->
        <!-- ═══════════════════════════════════════════════ -->
        <record id="view_law_import_wizard_form" model="ir.ui.view">
            <field name="name">bpm.law.import.wizard.form</field>
            <field name="model">bpm.law.import</field>
            <field name="arch" type="xml">
                <form string="Import Laws from lagen.nu">
                    <group>
                        <p class="text-muted">
                            Import Swedish laws (SFS) from the pre-loaded database
                            with lagen.nu references. Leave SFS numbers empty to
                            import all known laws.
                        </p>
                        <field name="company_id" invisible="1"/>
                        <field name="source" widget="radio"/>
                        <field name="sfs_numbers"
                               placeholder="1977:1160&#10;2005:551&#10;1999:1078"/>
                    </group>
                    <footer>
                        <button name="action_import" string="Import Laws"
                                type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_law_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Laws from lagen.nu</field>
            <field name="res_model">bpm.law.import</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Actions & Menus                                -->
        <!-- ═══════════════════════════════════════════════ -->
        <record id="action_law_package" model="ir.actions.act_window">
            <field name="name">Law Packages</field>
            <field name="res_model">bpm.law.package</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <menuitem id="menu_law_packages"
                  name="Law Packages"
                  parent="bpm_workflow.menu_bpm_workflow_root"
                  action="action_law_package"
                  sequence="30"
                  groups="bpm_workflow.group_bpm_manager"/>

        <menuitem id="menu_law_import"
                  name="Import Laws (lagen.nu)"
                  parent="menu_law_packages"
                  action="action_law_import_wizard"
                  sequence="10"
                  groups="bpm_workflow.group_bpm_manager"/>

    </data>
</odoo>
